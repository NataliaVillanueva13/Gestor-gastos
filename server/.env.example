PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gestor_gastos
# Generá uno largo y aleatorio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
# En desarrollo con Vite el front corre en este origen
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- IA (cargar gastos con una frase o la foto del ticket) ---
# La key vive solo acá, nunca en el cliente. Sin key, la app funciona igual pero sin esa función.
OPENAI_API_KEY=
# Verificá los modelos vigentes; para fotos tiene que aceptar imágenes.
IA_MODELO=gpt-4.1-mini
# Opcional: otro servidor compatible, por ejemplo Ollama local
# OPENAI_BASE_URL=http://localhost:11434/v1
# Gemini (Google AI Studio) por su API compatible con OpenAI:
# OPENAI_API_KEY=tu-key-de-gemini
# IA_MODELO=gemini-3.8-flash
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Opcional, para modelos que razonan (se envía como reasoning_effort):
# IA_RAZONAMIENTO=low

# --- Producción de la IA (capítulo 8) ---
# Plan B: si el modelo principal falla por algo transitorio (429, 5xx, timeout), se prueba una vez con este
# IA_MODELO_RESPALDO=gemini-3.5-flash-lite
# Presupuesto diario global en tokens: alerta en consola al 80 %, corte al 100 %
IA_LIMITE_DIARIO_TOKENS=200000
# Precios en USD por millón de tokens, para ver costos en `npm run metricas` (verificá los vigentes)
# IA_PRECIO_ENTRADA_USD=
# IA_PRECIO_SALIDA_USD=
# Timeout por llamada en ms (30000 por defecto). Con Ollama conviene más: la primera llamada carga el modelo
# IA_TIMEOUT_MS=90000
# Cómo se redacta la respuesta a las preguntas: "modelo" (por defecto, segunda llamada a la IA)
# o "plantilla" (la arma el código con los datos: más rápido y sin cifras inventadas; recomendado con Ollama)
# IA_REDACCION=plantilla

# --- Opcional: proveedor aparte solo para la foto del ticket (modo mixto) ---
# Útil cuando el modelo principal no lee imágenes (por ejemplo qwen3 en Ollama).
# Sin IA_IMAGEN_MODELO, la foto va al proveedor principal.
# IA_IMAGEN_MODELO=gemini-3.5-flash-lite
# IA_IMAGEN_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# IA_IMAGEN_API_KEY=tu-key-de-gemini
# IA_IMAGEN_RAZONAMIENTO=
# IA_IMAGEN_TIMEOUT_MS=30000
